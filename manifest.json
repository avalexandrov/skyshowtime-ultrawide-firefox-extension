{
  "manifest_version": 3,
  "name": "SkyShowtime Ultrawide",
  "version": "1.0.1",
  "description": "Adds an optional per-title fill mode to SkyShowtime playback on ultrawide displays.",
  "homepage_url": "https://github.com/avalexandrov/skyshowtime-ultrawide-firefox-extension",
  "browser_specific_settings": {
    "gecko": {
      "id": "{c8e95e6f-0a3e-4ed0-8378-51feff942e02}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["storage"],
  "background": {
    "scripts": ["background/background.js"]
  },
  "action": {
    "default_title": "SkyShowtime Ultrawide",
    "default_popup": "popup/popup.html"
  },
  "icons": {
    "48": "icons/icon.svg",
    "96": "icons/icon.svg"
  },
  "commands": {
    "toggle-ultrawide": {
      "suggested_key": {
        "default": "Alt+Shift+U",
        "mac": "Command+Shift+U"
      },
      "description": "Toggle Fill Ultrawide for the current SkyShowtime video"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.skyshowtime.com/*"],
      "js": ["content/content.js"],
      "run_at": "document_idle"
    }
  ]
}
